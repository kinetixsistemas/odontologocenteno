---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQ from '@/components/FAQ.astro';
import { SITE } from '@/config/site';
import { getOrganizationSchema } from '@/components/SchemaOrg.astro';

export async function getStaticPaths() {
  const entries = await getCollection('tratamientos');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const wa = `${SITE.phone.whatsapp}?text=${encodeURIComponent(`Hola, quisiera agendar una cita para ${data.serviceName}.`)}`;
const canonical = new URL(`/servicios/${entry.id}/`, SITE.domain).href;
const related = SITE.treatments.filter((t) => t.slug !== entry.id);

const schema = [
  getOrganizationSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${data.serviceName} en ${data.city}`,
    serviceType: data.serviceName,
    description: data.description,
    provider: { '@type': 'Dentist', name: SITE.clinicName, telephone: SITE.phone.e164 },
    areaServed: { '@type': 'City', name: 'Punto Fijo' },
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
];
---
<BaseLayout title={`${data.serviceName} en ${data.city}, Falcón`} description={data.description} canonical={canonical} image={`/og/servicios-${entry.id}.png`} schema={schema}>
  <Breadcrumbs items={[{ name: 'Servicios', href: '/servicios/' }, { name: data.serviceName, href: `/servicios/${entry.id}/` }]} />
  <article>
    <header class="container-site py-8">
      <p class="eyebrow">TRATAMIENTO</p>
      <h1 class="mt-2 text-4xl md:text-5xl">{data.serviceName} en {data.city}, Estado Falcón</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-secondary/90">{data.intro}</p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href={`/agendar-cita/?tratamiento=${entry.id}`} class="btn-primary">Agendar cita</a>
        <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-outline" data-track="click_whatsapp_treatment">Consultar por WhatsApp</a>
      </div>
    </header>

    {data.benefits.length > 0 && (
      <section class="bg-surface py-10" aria-labelledby="beneficios">
        <div class="container-site">
          <h2 id="beneficios" class="text-3xl">Beneficios y consideraciones</h2>
          <ul class="mt-6 grid gap-3 md:grid-cols-2">
            {data.benefits.map((b) => <li class="card p-4 text-secondary/90">{b}</li>)}
          </ul>
        </div>
      </section>
    )}

    <section class="container-site content max-w-none py-10">
      <h2 class="text-3xl">Detalles del tratamiento</h2>
      {data.duration && <p><strong>Duración aproximada:</strong> {data.duration}</p>}
      {data.idealFor && <p><strong>Para quién puede ser indicado:</strong> {data.idealFor}</p>}
      <div class="mt-4 leading-relaxed">
        <Content />
      </div>
      <p class="mt-6 rounded-card border border-border bg-background p-4 text-sm"><strong>Aviso:</strong> {SITE.medicalDisclaimer}</p>
      <p class="mt-2 text-sm text-secondary/70">Última revisión: {data.lastReviewed}.</p>
    </section>

    {data.faqs.length > 0 && <FAQ items={data.faqs} heading={`Preguntas frecuentes sobre ${data.serviceName.toLowerCase()}`} />}

    <section class="bg-surface py-12" aria-labelledby="tratamientos-relacionados">
      <div class="container-site">
        <h2 id="tratamientos-relacionados" class="text-3xl md:text-4xl">Otros tratamientos en Punto Fijo</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {related.map((t) => (
            <a href={`/servicios/${t.slug}/`} class="card p-5 transition hover:border-primary">
              <h3 class="font-body text-lg font-semibold">{t.name}</h3>
              <p class="mt-1 text-sm text-secondary/85">{t.short}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="container-site py-12 text-center">
      <h2 class="text-3xl">¿Deseas agendar una cita para {data.serviceName.toLowerCase()}?</h2>
      <p class="mt-3 text-secondary/90">Atención en {SITE.clinicName}, Punto Fijo, Estado Falcón.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href={`/agendar-cita/?tratamiento=${entry.id}`} class="btn-primary">Agendar cita</a>
        <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-outline">WhatsApp</a>
      </div>
    </section>
  </article>
</BaseLayout>

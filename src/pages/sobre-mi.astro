---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQ from '@/components/FAQ.astro';
import { SITE } from '@/config/site';
import { getDoctorSchema, getOrganizationSchema } from '@/components/SchemaOrg.astro';

const faqs = [
  {
    question: '¿Quién es la Od. Albany Centeno?',
    answer: 'La Od. Albany Centeno es odontóloga y atiende en Centro Medico Luna Design, en Punto Fijo, Estado Falcón. Su práctica se orienta a la odontología general y la estética dental, con atención personalizada.',
  },
  {
    question: '¿Dónde atiende la Od. Albany Centeno?',
    answer: 'Atiende en Calle Girardot con esquina de la Calle Nazaret (N° 25-262), Punto Fijo, Estado Falcón, Venezuela.',
  },
  {
    question: '¿Qué tratamientos ofrece?',
    answer: 'Ofrece limpieza dental, extracción dental y ortodoncia. La evaluación y el plan de tratamiento se definen en consulta según cada paciente.',
  },
  {
    question: '¿Cómo puedo verificar su formación y registro profesional?',
    answer: 'La formación, el número de colegiatura/registro y la experiencia deben ser verificables. Los datos específicos se encuentran pendientes de completar en este sitio y pueden solicitarse en el consultorio.',
  },
];

const schema = [
  getOrganizationSchema(),
  getDoctorSchema(),
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) },
];
---
<BaseLayout title="Sobre la Od. Albany Centeno" description="Conoce a la Od. Albany Centeno, odontóloga en Punto Fijo, Estado Falcón. Formación, especialidad y atención en Centro Medico Luna Design." image="/og/sobre-mi.png" schema={schema}>
  <Breadcrumbs items={[{ name: 'Sobre mí', href: '/sobre-mi/' }]} />
  <section class="container-site grid gap-10 py-10 md:grid-cols-2 md:items-start">
    <div class="card flex min-h-96 items-center justify-center bg-primary/10 p-8 text-center text-secondary/80">
      <div>
        <p class="font-heading text-2xl">[PENDIENTE: foto real profesional de la Od. Albany Centeno]</p>
        <p class="mt-2 text-sm">Marcador de posición identificado — usar fotografía real y verificable.</p>
      </div>
    </div>
    <div>
      <p class="eyebrow">SOBRE MÍ</p>
      <h1 class="mt-2 text-4xl md:text-5xl">{SITE.doctorName}</h1>
      <p class="mt-2 text-lg">{SITE.specialty} · {SITE.address.city}, {SITE.address.region}</p>
      <p class="mt-5 leading-relaxed text-secondary/90">La {SITE.doctorName} atiende en {SITE.clinicName} en Punto Fijo, Estado Falcón. Su labor se orienta a brindar atención odontológica con trato humano, información clara y enfoque en la salud bucal de cada paciente.</p>

      <div class="mt-8 space-y-5">
        <section class="card p-5">
          <h2 class="font-body text-xl font-semibold">Formación</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-secondary/90">
            {SITE.credentials.education.map((e) => <li>{e}</li>)}
          </ul>
        </section>
        <section class="card p-5">
          <h2 class="font-body text-xl font-semibold">Experiencia y ejercicio profesional</h2>
          <p class="mt-2 text-secondary/90">{SITE.credentials.experience}</p>
          <p class="mt-2 text-secondary/90"><strong>Número de colegiatura/registro profesional:</strong> {SITE.credentials.license}</p>
        </section>
        <section class="card p-5">
          <h2 class="font-body text-xl font-semibold">Especialidades y áreas de atención</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-secondary/90">
            <li><a class="underline" href="/servicios/limpieza-dental/">Limpieza dental (profilaxis)</a></li>
            <li><a class="underline" href="/servicios/extraccion-dental/">Extracción dental</a></li>
            <li><a class="underline" href="/servicios/ortodoncia/">Ortodoncia</a></li>
            <li>Odontología general y orientación en salud bucal</li>
          </ul>
        </section>
        <section class="card p-5">
          <h2 class="font-body text-xl font-semibold">Asociaciones profesionales</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-secondary/90">
            {SITE.credentials.associations.map((a) => <li>{a}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </section>

  <section class="bg-surface py-12" aria-labelledby="enfoque-atencion">
    <div class="container-site">
      <p class="eyebrow">ENFOQUE DE ATENCIÓN</p>
      <h2 id="enfoque-atencion" class="mt-2 text-3xl md:text-4xl">Cómo es una consulta con la {SITE.doctorName}</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {[
          { t: 'Escucha y evaluación', d: 'Se conversa sobre tu motivo de consulta y se realiza la valoración clínica necesaria.' },
          { t: 'Explicación clara', d: 'Se explican los hallazgos y las opciones de tratamiento en lenguaje comprensible.' },
          { t: 'Plan personalizado', d: 'El diagnóstico y el plan se definen según tus necesidades, con indicaciones de seguimiento.' },
        ].map((item) => (
          <div class="card p-5"><h3 class="font-body text-lg font-semibold">{item.t}</h3><p class="mt-2 text-sm text-secondary/90">{item.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-site py-12" aria-labelledby="verificabilidad">
    <div class="card p-6 md:p-8">
      <h2 id="verificabilidad" class="text-2xl md:text-3xl">Información verificable (E-E-A-T)</h2>
      <p class="mt-3 text-secondary/90">La información profesional de esta página debe poder comprobarse. Los campos marcados como [PENDIENTE] serán completados con datos reales de la doctora: formación, registro profesional, años de experiencia, asociaciones y fotografía.</p>
      <ul class="mt-4 space-y-2 text-secondary/90">
        <li><strong>Nombre:</strong> {SITE.doctorName}</li>
        <li><strong>Consultorio:</strong> {SITE.clinicName}</li>
        <li><strong>Especialidad:</strong> {SITE.specialty}</li>
        <li><strong>Registro/colegiatura:</strong> {SITE.credentials.license}</li>
        <li><strong>Experiencia:</strong> {SITE.credentials.experience}</li>
        <li><strong>Ubicación:</strong> {SITE.address.full}</li>
      </ul>
    </div>
  </section>

  <FAQ items={faqs} heading="Preguntas frecuentes sobre la doctora" />

  <section class="container-site py-12 text-center">
    <h2 class="text-3xl">Agenda una consulta</h2>
    <p class="mt-3 text-secondary/90">Solicita tu cita con la {SITE.doctorName} en Punto Fijo, Estado Falcón.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <a href="/agendar-cita/" class="btn-primary">Agendar cita</a>
      <a href="/servicios/" class="btn-outline">Ver servicios</a>
    </div>
  </section>
  <p class="container-site pb-12 text-sm text-secondary/70">{SITE.medicalDisclaimer} Última revisión: {SITE.lastReviewed}.</p>
</BaseLayout>

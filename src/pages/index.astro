---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getOrganizationSchema, getDoctorSchema } from '@/components/SchemaOrg.astro';

const schema = [getOrganizationSchema(), getDoctorSchema()];
const waHero = `${SITE.phone.whatsapp}?text=${encodeURIComponent('Hola, quisiera agendar una cita con la Od. Albany Centeno.')}`;
const googleReviewReady = SITE.socials.googleReview?.startsWith('http');
---
<BaseLayout
  title="Odontóloga en Punto Fijo, Estado Falcón"
  description="Od. Albany Centeno en Centro Medico Luna Design, Punto Fijo. Limpieza dental, ortodoncia y extracción dental con atención personalizada. Agenda tu cita."
  image="/og/home.png"
  schema={schema}
>
  <section class="relative overflow-hidden bg-gradient-to-br from-background via-[#f6ecf8] to-primary/20">
    <div class="container-site grid items-center gap-10 py-12 md:grid-cols-[1.05fr_0.95fr] md:py-20">
      <div>
        <p class="eyebrow">TU SONRISA, NUESTRA PRIORIDAD</p>
        <h1 class="mt-3 text-4xl leading-tight md:text-6xl">{SITE.doctorName}</h1>
        <p class="mt-2 font-body text-lg text-secondary/90">Odontóloga en Punto Fijo, Estado Falcón</p>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-secondary/90">
          Cuida tu sonrisa con atención personalizada, orientación clara y un trato humano. La {SITE.doctorName} atiende en {SITE.clinicName}, en Punto Fijo, Estado Falcón, en limpieza dental, ortodoncia y extracción dental.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/agendar-cita/" class="btn-primary" data-track="cta_hero_agendar">Agendar mi cita <span aria-hidden="true">→</span></a>
          <a href={waHero} target="_blank" rel="noopener noreferrer" class="btn-outline" data-track="click_whatsapp_hero">Escríbeme por WhatsApp</a>
        </div>
      </div>
      <div class="relative">
        <div class="card flex aspect-[4/5] items-center justify-center overflow-hidden bg-primary/20 p-6 text-center">
          <div>
            <img src="/images/logo-principal.png" alt="" width="120" height="120" class="mx-auto mb-4 h-28 w-28 object-contain opacity-80" loading="eager" />
            <p class="font-heading text-2xl">[PENDIENTE: fotografía profesional de la Od. Albany Centeno]</p>
            <p class="mt-2 text-sm text-secondary/80">Marcador de posición — usar imagen real de la doctora en el consultorio.</p>
          </div>
        </div>
        <p class="mt-4 text-center font-heading text-xl italic text-secondary/80">"Tu sonrisa, nuestra mayor motivación"</p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-surface" aria-labelledby="servicios-destacados">
    <div class="container-site py-10">
      <h2 id="servicios-destacados" class="sr-only">Servicios destacados</h2>
      <div class="grid grid-cols-1 gap-4 text-center sm:grid-cols-3">
        {SITE.treatments.map((s) => (
          <a href={`/servicios/${s.slug}/`} class="group rounded-card border border-border bg-surface p-6 transition hover:-translate-y-0.5 hover:border-primary">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-background text-secondary" aria-hidden="true">
              {s.slug === 'limpieza-dental' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c-3 0-5 2-5 5 0 2 .7 3.2 1.2 4.6.4 1.1.6 2.4.8 3.7.1 1 .5 2.7 1.5 2.7s1.2-1.6 1.5-2.7c.3-1.2.6-2.3 1-2.3s.7 1.1 1 2.3c.3 1.1.5 2.7 1.5 2.7s1.4-1.7 1.5-2.7c.2-1.3.4-2.6.8-3.7C16.3 11.2 17 10 17 8c0-3-2-5-5-5Z"/></svg>
              )}
              {s.slug === 'extraccion-dental' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c-3 0-5 2-5 5 0 2 .7 3.2 1.2 4.6.4 1.1.6 2.4.8 3.7.1 1 .5 2.7 1.5 2.7s1.2-1.6 1.5-2.7c.3-1.2.6-2.3 1-2.3s.7 1.1 1 2.3c.3 1.1.5 2.7 1.5 2.7s1.4-1.7 1.5-2.7c.2-1.3.4-2.6.8-3.7C16.3 11.2 17 10 17 8c0-3-2-5-5-5Z"/><path d="m15.5 4.5 3 3M18.5 4.5l-3 3"/></svg>
              )}
              {s.slug === 'ortodoncia' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 8h16M4 16h16M8 6v4m4-4v4m4-4v4M8 14v4m4-4v4m4-4v4"/></svg>
              )}
            </span>
            <p class="mt-3 font-body text-lg font-semibold">{s.name}</p>
            <p class="mt-2 text-sm text-secondary/80">{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container-site grid gap-10 py-16 md:grid-cols-2 md:items-center" aria-labelledby="sobre-odontologa">
    <div class="card flex min-h-72 items-center justify-center bg-primary/10 p-8 text-center">
      <div>
        <p class="font-heading text-2xl">[PENDIENTE: fotografía estética del consultorio, instrumental o detalle dental]</p>
        <p class="mt-2 text-sm text-secondary/80">Marcador de posición — no usar stock que simule la clínica.</p>
      </div>
    </div>
    <div>
      <p class="eyebrow">SOBRE MÍ</p>
      <h2 id="sobre-odontologa" class="mt-2 text-3xl md:text-4xl">Experiencia y compromiso al servicio de tu sonrisa</h2>
      <p class="mt-4 leading-relaxed text-secondary/90">Soy la {SITE.doctorName}. Mi propósito es ayudarte a cuidar tu salud bucal con tratamientos seguros, personalizados y tecnología adecuada para cada caso, en un ambiente de confianza en Punto Fijo, Estado Falcón.</p>
      <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {['Atención personalizada', 'Orientación clara', 'Trato humano', 'Enfoque preventivo'].map((f) => (
          <li class="flex items-center gap-2"><span class="text-primary" aria-hidden="true">●</span><span>{f}</span></li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/sobre-mi/" class="btn-outline">Conoce más sobre mí</a>
        <a href="/servicios/" class="btn-outline">Ver servicios</a>
      </div>
    </div>
  </section>

  <section class="bg-surface py-16" aria-labelledby="agenda-y-testimonios">
    <div class="container-site grid gap-8 lg:grid-cols-2">
      <div class="rounded-card border border-border bg-background p-6 md:p-8">
        <p class="eyebrow">AGENDA TU CITA</p>
        <h2 id="agenda-y-testimonios" class="mt-2 text-3xl md:text-4xl">Tu próxima cita, más fácil que nunca</h2>
        <p class="mt-3 text-secondary/90">Selecciona el servicio de interés, elige una hora disponible y solicita tu cita en pocos pasos.</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {SITE.treatments.map((t) => (
            <a href={`/agendar-cita/?tratamiento=${encodeURIComponent(t.slug)}`} class="rounded-full border border-secondary/30 bg-surface px-4 py-2 text-sm text-secondary transition hover:border-secondary">{t.name}</a>
          ))}
        </div>
        <div class="mt-6 rounded-xl border border-border bg-surface p-4">
          <p class="text-sm font-medium">Disponibilidad en línea</p>
          <p class="mt-2 text-xs text-secondary/70">Al seleccionar la fecha en el formulario verás únicamente las horas libres de la agenda del consultorio.</p>
        </div>
        <a href="/agendar-cita/" class="btn-primary mt-6">Reservar cita</a>
      </div>

      <div class="rounded-card border border-border bg-surface p-6 md:p-8">
        <p class="eyebrow">TESTIMONIOS</p>
        <h2 class="mt-2 text-3xl md:text-4xl">La confianza de nuestros pacientes</h2>
        <div class="mt-5 space-y-3">
          {[1, 2, 3].map((i) => (
            <div class="rounded-xl border border-dashed border-border bg-background/60 p-4">
              <p class="text-sm font-medium text-secondary/80">Espacio reservado para reseña real {i}</p>
              <p class="mt-1 text-xs text-secondary/60">[PENDIENTE: testimonio verificable con consentimiento documentado]</p>
            </div>
          ))}
        </div>
        {googleReviewReady ? (
          <a href={SITE.socials.googleReview} target="_blank" rel="noopener noreferrer" class="btn-outline mt-6">Déjanos tu reseña en Google</a>
        ) : (
          <p class="mt-6 text-sm text-secondary/70">Enlace de reseña Google: {SITE.socials.googleReview}</p>
        )}
      </div>
    </div>
  </section>

  <section class="container-site py-16" aria-labelledby="diferenciadores">
    <p class="eyebrow">DIFERENCIADORES</p>
    <h2 id="diferenciadores" class="mt-2 text-3xl md:text-4xl">Por qué elegir a la {SITE.doctorName}</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {[
        { t: 'Orientación al paciente', d: 'Explicaciones claras sobre cada procedimiento para que puedas tomar decisiones informadas.' },
        { t: 'Atención en Punto Fijo', d: 'Consulta odontológica en el Estado Falcón, con ubicación accesible y contacto directo.' },
        { t: 'Citas sencillas', d: 'Solicita tu cita por WhatsApp o desde la web y recibe confirmación de disponibilidad.' },
      ].map((item) => (
        <div class="card p-6"><h3 class="font-body text-xl font-semibold">{item.t}</h3><p class="mt-2 text-secondary/85">{item.d}</p></div>
      ))}
    </div>
  </section>

  <section class="bg-surface py-16" aria-labelledby="fotografias">
    <div class="container-site">
      <p class="eyebrow">TRATAMIENTOS Y CONSULTORIO</p>
      <h2 id="fotografias" class="mt-2 text-3xl md:text-4xl">Conoce el espacio y la atención</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="card flex min-h-64 items-center justify-center bg-primary/10 p-8 text-center text-secondary/80">[PENDIENTE: fotografía real del consultorio]</div>
        <div class="card flex min-h-64 items-center justify-center bg-primary/10 p-8 text-center text-secondary/80">[PENDIENTE: fotografía real de un tratamiento o instrumental]</div>
      </div>
    </div>
  </section>

  <section class="container-site py-16" aria-labelledby="ubicacion-home">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="card p-6 md:p-8">
        <p class="eyebrow">NUESTRA UBICACIÓN</p>
        <h2 id="ubicacion-home" class="mt-2 text-3xl md:text-4xl">Visítanos en Punto Fijo</h2>
        <p class="mt-4">{SITE.clinicName}</p>
        <p class="mt-1 text-secondary/90">{SITE.address.full}</p>
        <p class="mt-2 text-secondary/90">Horario: {SITE.hours.label} · {SITE.hours.detail}</p>
        <p class="mt-1 text-sm text-secondary/80">Referencia: Calle Girardot con esquina de la Calle Nazaret. Plus code: {SITE.geo.plusCode}.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={SITE.geo.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-outline">Ver en Google Maps</a>
          <a href={SITE.phone.tel} class="btn-outline" data-track="click_call_home">Llamar</a>
        </div>
      </div>
      <div class="card p-6 md:p-8">
        <p class="eyebrow">BLOG ODONTOLÓGICO</p>
        <h2 class="mt-2 text-3xl md:text-4xl">Consejos para una sonrisa sana</h2>
        <p class="mt-3 text-secondary/90">Descubre artículos, tips y cuidados para tu salud bucal, con respuestas claras a preguntas frecuentes de pacientes en Falcón.</p>
        <div class="mt-5 card flex min-h-40 items-center justify-center bg-primary/10 p-6 text-center text-sm text-secondary/80">[PENDIENTE: imagen estética de cuidado dental]</div>
        <a href="/blog/" class="btn-outline mt-6">Explorar blog</a>
      </div>
    </div>
  </section>

  <section class="container-site pb-16 text-center">
    <h2 class="text-3xl md:text-4xl">Agenda tu cita odontológica</h2>
    <p class="mx-auto mt-3 max-w-2xl text-secondary/90">Solicita tu cita para limpieza dental, ortodoncia o extracción dental en Punto Fijo, Estado Falcón.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <a href="/agendar-cita/" class="btn-primary">Agendar cita</a>
      <a href={`${SITE.phone.whatsapp}?text=${encodeURIComponent('Hola, quisiera agendar una cita.')}`} target="_blank" rel="noopener noreferrer" class="btn-outline">WhatsApp</a>
    </div>
  </section>
  <p class="container-site pb-12 text-sm text-secondary/70">{SITE.medicalDisclaimer} Última revisión: {SITE.lastReviewed}.</p>
</BaseLayout>

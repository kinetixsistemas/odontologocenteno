---
import { SITE } from '@/config/site';
interface Props { message?: string }
const { message = `Hola, quisiera agendar una cita en ${SITE.clinicName}.` } = Astro.props;
const href = `${SITE.phone.whatsapp}?text=${encodeURIComponent(message)}`;
---
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:scale-105 focus-visible:outline-[#25D366]"
  aria-label="Escribir por WhatsApp"
  data-track="click_whatsapp_float"
>
  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M19.11 17.2c-.28-.14-1.64-.81-1.9-.9-.25-.1-.44-.14-.62.14-.19.28-.72.9-.88 1.08-.16.19-.33.21-.61.07-.28-.14-1.17-.43-2.23-1.38-.82-.73-1.38-1.64-1.54-1.92-.16-.28-.02-.43.12-.57.13-.13.28-.33.42-.49.14-.16.19-.28.28-.47.09-.19.05-.35-.02-.49-.07-.14-.62-1.5-.85-2.06-.22-.53-.45-.46-.62-.47h-.53c-.19 0-.49.07-.75.35-.25.28-.98.96-.98 2.33 0 1.38 1 2.71 1.14 2.9.14.19 1.97 3.01 4.78 4.22.67.29 1.19.46 1.6.59.67.21 1.28.18 1.76.11.54-.08 1.64-.67 1.87-1.31.23-.65.23-1.2.16-1.31-.07-.12-.26-.19-.53-.33z"/><path d="M26.67 5.33A14.6 14.6 0 0 0 16.27.67C8.19.67 1.61 7.25 1.61 15.33c0 2.58.67 5.1 1.95 7.33L1.33 31.33l8.86-2.33a14.6 14.6 0 0 0 6.08 1.33h.01c8.08 0 14.66-6.58 14.66-14.66 0-3.92-1.53-7.6-4.27-10.34zM16.28 28a12.1 12.1 0 0 1-6.17-1.69l-.44-.26-5.26 1.38 1.4-5.13-.29-.46a12.1 12.1 0 1 1 10.76 6.16z"/></svg>
</a>

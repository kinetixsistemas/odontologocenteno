---
interface FaqItem { question: string; answer: string }
interface Props { items: FaqItem[]; heading?: string }
const { items, heading = 'Preguntas frecuentes' } = Astro.props;
---
<section class="container-site py-12" aria-labelledby="faq-title">
  <h2 id="faq-title" class="text-3xl md:text-4xl">{heading}</h2>
  <div class="mt-6 space-y-4">
    {items.map((faq) => (
      <article class="card p-5">
        <h3 class="font-body text-lg font-semibold text-secondary">{faq.question}</h3>
        <p class="mt-2 text-secondary/90 leading-relaxed">{faq.answer}</p>
      </article>
    ))}
  </div>
</section>

# URL base del sistema del consultorio (sin barra final).
# Local: http://localhost:3000 · Producción: https://<host-del-consultorio>
PUBLIC_API_BASE_URL=

# API key pública del consultorio. Debe coincidir con PUBLIC_API_KEY del sistema.
PUBLIC_API_KEY=

# Google Analytics 4 (opcional). Si está vacío, no se carga gtag.
PUBLIC_GA4_ID=

# Verificación de propiedad en Google Search Console (opcional).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Fallback del formulario si la API de citas no está configurada: whatsapp | mailto | endpoint | google-sheets
PUBLIC_FORM_MODE=whatsapp

# Requerido para endpoint/google-sheets. Debe aceptar POST JSON y CORS desde el dominio del sitio.
PUBLIC_FORM_ENDPOINT=

# Requerido para mailto.
PUBLIC_FORM_EMAIL=
